{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and app settings",
      "properties": {
        "uid": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" },
        "settings": { "type": "object" },
        "dailyTarget": { "type": "object" }
      },
      "required": ["uid", "createdAt"]
    },
    "sessions": {
      "title": "Study Sessions",
      "description": "Completed or logged study blocks",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "focusMinutes": { "type": "number" },
        "breakMinutes": { "type": "number" },
        "completedAt": { "type": "string" },
        "dateKey": { "type": "string" }
      },
      "required": ["userId", "focusMinutes", "completedAt"]
    },
    "tasks": {
      "title": "Daily Tasks",
      "description": "Tasks to complete for study goals",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "complete": { "type": "boolean" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "complete"]
    },
    "distractions": {
      "title": "Distraction Logs",
      "description": "Logged distractions during study blocks",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "sessionIntention": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "text", "createdAt"]
    },
    "notes": {
      "title": "Study Quick Notes",
      "description": "Scratchpad and quick study notes",
      "properties": {
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "daily": {
      "title": "Daily Aggregated Study Record",
      "description": "Aggregated daily document storing sessions, distractions, and stats per day to minimize reads",
      "properties": {
        "dateKey": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "number" },
        "stats": { "type": "object" },
        "sessions": { "type": "array" },
        "distractions": { "type": "array" }
      },
      "required": ["dateKey", "userId"]
    },
    "stats": {
      "title": "Overall Stats Summary",
      "description": "Single rollup summary document for overall user statistics",
      "properties": {
        "userId": { "type": "string" },
        "totalFocusMinutes": { "type": "number" },
        "totalSessions": { "type": "number" },
        "totalDistractions": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "User account settings and profile"
    },
    "users/{userId}/daily/{dateKey}": {
      "schema": "daily",
      "description": "Daily aggregated sessions and distractions"
    },
    "users/{userId}/stats/summary": {
      "schema": "stats",
      "description": "Overall stats rollup summary"
    },
    "tasks/{taskId}": {
      "schema": "tasks",
      "description": "User tasks"
    },
    "notes/{userId}": {
      "schema": "notes",
      "description": "User study notes"
    },
    "activity_logs/{logId}": {
      "schema": "sessions",
      "description": "Activity journal logs"
    }
  }
}
